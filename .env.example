# Modelo de configuração do Higi Leito PRO.
# No servidor: o install.ps1 cria o arquivo .env a partir deste modelo.
# Na sua máquina: copie para .env.local. Os dois ficam fora do git, nunca faça commit deles.

# --- Banco de dados (obrigatório) ---
# Servidor: preenchido pelo install.ps1.
# Desenvolvimento com "npm run dev:db": postgres://postgres:postgres@127.0.0.1:54320/higi_leito
DATABASE_URL=postgres://higi_app:TROQUE_A_SENHA@127.0.0.1:5432/higi_leito

# --- Servidor web ---
PORT=5173
# 0.0.0.0 = acessível pela rede. 127.0.0.1 = só pelo próprio servidor (usado atrás do proxy).
HOST=0.0.0.0
# Prefixo do endereço quando o Higi divide a porta com outro sistema (ex.: /higi).
# Vazio = o Higi fica na raiz da porta. O install-proxy.ps1 preenche isto sozinho.
# Mudou? Rode "npm run build" e reinicie os serviços.
HIGI_BASE_PATH=

# E-mail que poderá criar o primeiro administrador (só pelo próprio servidor, em http://localhost:3000).
HIGI_ADMIN_EMAIL=

# HTTPS (opcional): caminho do certificado .pfx emitido pela TI e a senha dele.
# Vazio = HTTP simples (aceitável apenas dentro da rede interna).
HIGI_TLS_PFX_PATH=
HIGI_TLS_PFX_PASSPHRASE=

# --- Integração Oracle / MV ---
# Sem usuário, senha e connect string, a sincronização de leitos fica desligada.
HIGI_ORACLE_USER=
HIGI_ORACLE_PASSWORD=
HIGI_ORACLE_CONNECT_STRING=
# Pasta do Oracle Instant Client (a que contém o OCI.dll).
HIGI_ORACLE_CLIENT_LIB_DIR=
# Empresas sincronizadas (códigos do MV, separados por vírgula).
HIGI_ORACLE_COMPANIES=1,18,19
# Intervalo de consulta ao Oracle em ms (mínimo 2000).
HIGI_ORACLE_POLL_INTERVAL_MS=2000

# --- Webhook (opcional) ---
# Cada alteração é enviada por POST com a assinatura HMAC no cabeçalho X-Higi-Signature.
HIGI_WEBHOOK_URL=
HIGI_WEBHOOK_SECRET=

# --- Backup (usado por deploy\windows\backup.ps1) ---
# Pasta de destino. Recomendado: uma pasta de rede FORA deste servidor.
# Vazio = pasta "backups" dentro do projeto.
HIGI_BACKUP_DIR=
HIGI_BACKUP_KEEP_DAYS=14
