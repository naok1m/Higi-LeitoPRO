{
  "name": "Employee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "registration": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "shift": {
      "type": "string",
      "enum": [
        "manha",
        "tarde",
        "noite"
      ],
      "default": "manha"
    },
    "phone": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}